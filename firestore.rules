rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /guardrails/{guardrailId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /loan_officers/{loId} {
      allow read, write: if true;
    }

    match /realtor_agents/{agentId} {
      allow read, write: if true;
    }

    match /property_notes/{noteId} {
      allow read, write: if true;
    }

    match /lead_conversations/{convId} {
      allow read, write: if true;
    }

    match /stored_archives/{archiveId} {
      allow read, write: if true;
    }

    match /pending_outbound_queue/{msgId} {
      allow read, write: if true;
    }

    match /lead_outreach_cron_configs/{configId} {
      allow read, write: if true;
    }
  }
}
